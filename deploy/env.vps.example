# ============================================================================
# QUANT KALSHI - .env para VPS Linux 24/7
# ----------------------------------------------------------------------------
#   cp deploy/env.vps.example .env    &&    nano .env
#
# Este archivo NO se versiona (.gitignore). Las claves privadas PEM tampoco:
# dejales permisos 600 y fuera del repositorio.
# ============================================================================

# ===== Plano de DATOS vs plano de DINERO =====
# production = donde viven los ~2.826 mercados con volumen (entorno normal del bot)
# demo       = exchange con dinero ficticio, para validar el cableado de ordenes
# auto       = detecta en arranque en que entorno son validas tus credenciales
KALSHI_ENV=production

# Interlock de dinero real. En produccion, colocar ordenes esta BLOQUEADO salvo
# que pongas esto en true. Dejalo en false hasta que hayas validado en demo.
ALLOW_REAL_MONEY=false

# Tope duro por orden real (USD). Freno de ultimo recurso contra un bug de sizing;
# no se puede subir desde el dashboard.
LIVE_ABS_MAX_ORDER_USD=50

# ===== Credenciales (Kalshi no las comparte entre entornos) =====
# Crea la key en la web de Kalshi y guarda el PEM en la VPS:
#   mkdir -p ~/.kalshi && chmod 700 ~/.kalshi
#   nano ~/.kalshi/prod_key.pem && chmod 600 ~/.kalshi/prod_key.pem
# Acepta RSA (PKCS#1) y Ed25519 (PKCS#8).
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=/home/CAMBIA_ESTO/.kalshi/prod_key.pem

# Cuenta demo (se crea aparte en demo.kalshi.co):
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=/home/CAMBIA_ESTO/.kalshi/demo_ed25519_key.pem

# ===== Deteccion de entorno =====
# Se usa /portfolio/positions: en demo el endpoint de balance da HTTP 500 ~30% de
# las veces y eso hacia aterrizar en produccion por error.
KALSHI_ENV_PROBE_PATH=/portfolio/positions
KALSHI_ENV_PROBE_ATTEMPTS=3

KALSHI_WEBSOCKET_ENABLED=true
MIN_LIQUIDITY=0
MIN_VOLUME_24H=0
MAX_MARKETS_TRACKED=500
MAX_ORDERBOOK_POLLS_PER_CYCLE=50

# ===== Universo de mercados =====
MAX_MARKETS_SCANNED=1600
MAX_MARKETS_WITH_EVENT_CONTEXT=900
MARKET_MIN_VOLUME_24H=1
MARKET_MIN_OPEN_INTEREST=1
MAX_EVENTS_TRACKED=4000
EVENT_POLL_INTERVAL=300
PRUNE_STALE_AFTER_SECONDS=1800

# ===== Admision de operaciones en Paper Trading =====
PAPER_MIN_LIQUIDITY_USD=500
PAPER_MIN_VOLUME_24H_USD=250
PAPER_MIN_OPEN_INTEREST=100
PAPER_MIN_CONFIDENCE=75
PAPER_ALLOW_NON_FLASH=1

# ===== Bankroll: debe coincidir con el capital real a fondear =====
PAPER_INITIAL_BALANCE=1000
PAPER_MAX_EXPOSURE_USD=1000
PAPER_MAX_OPEN_POSITIONS=12

# ===== Realismo de ejecucion =====
# tick   -> fill realista (tick legal, profundidad, cola maker, comision, latencia)
# legacy -> modelo antiguo (slippage en bps, comision plana)
PAPER_FILL_MODEL=tick
# Kalshi cobra al taker ceil_a_centavo(0.07 * contratos * P * (1-P)); el maker no paga.
# En contratos baratos el redondeo a centavo pesa muchisimo (a 0.03 la comision es
# ~33% de la apuesta). fee_calibration.py mide la tasa real y la aplica al modelo.
PAPER_FEE_TAKER_RATE=0.07
PAPER_FEE_MAKER_RATE=0.0
PAPER_LATENCY_MS=900
PAPER_MAKER_FILL_PROBABILITY=0.35
PAPER_MAKER_MAX_PENDING_CYCLES=6
PAPER_DEPTH_SAFETY=0.5

# ===== Rate limits (Kalshi factura tokens; tier basic = 200 tokens/s) =====
KALSHI_READ_TOKENS_PER_SECOND=200
KALSHI_REQUEST_TOKEN_COST=10
KALSHI_RATE_HEADROOM=0.35

# ===== Mantenimiento programado (Kalshi pausa jueves 03:00-05:00 ET) =====
MAINTENANCE_DOW=3
MAINTENANCE_START_HOUR_ET=3
MAINTENANCE_END_HOUR_ET=5

# ===== Solo Docker =====
# El puerto se publica en 127.0.0.1 por defecto; accede por tunel SSH.
APP_PORT=8000
# UID/GID del usuario dueno del checkout, para que el estado no quede como root.
APP_UID=1000
APP_GID=1000
TZ=UTC
