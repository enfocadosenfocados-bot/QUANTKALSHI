# QUANT KALSHI local config - NO lo subas a git
# Valores admitidos: auto | demo | production
#
# produccion es el entorno de DATOS del bot (flujo de informacion real), que es lo
# que hace que una ganadora en simulacion siga ganando en real. El exchange demo se
# usa para VALIDAR el cableado de ordenes: comisiones, fills y liquidacion reales.
KALSHI_ENV=production

# ===== Credenciales por entorno =====
# Kalshi NO comparte API keys entre entorno: cada una solo vale en el suyo. El
# bot acepta RSA (PKCS#1) y Ed25519 (PKCS#8); firma con el que corresponda.
#
# Produccion:
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=C:\Users\TU_USUARIO\.kalshi\prod_key.pem
#
# Demo (se crea en demo.kalshi.co; es una cuenta aparte de la de produccion):
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=C:\Users\TU_USUARIO\.kalshi\demo_ed25519_key.pem

# Alternativa legacy (sin entorno declarado): se usa como respaldo si no hay
# KALSHI_DEMO_*/KALSHI_PROD_*, y se prueba contra ambos entornos.
# KALSHI_KEY_ID=
# KALSHI_PRIVATE_KEY_PATH=
# KALSHI_PRIVATE_KEY_PEM=-----

# ===== Interlock de dinero real =====
# `production` es el entorno de DATOS; enviar ordenes reales es una decision aparte.
# Con KALSHI_ENV=production + ALLOW_REAL_MONEY=false, ninguna orden sale del bot.
ALLOW_REAL_MONEY=false

# Tope duro por orden real (USD). Freno de ultimo recurso contra un bug de sizing:
# no se puede subir desde el dashboard.
LIVE_ABS_MAX_ORDER_USD=50

# Tope de ordenes reales vivas a la vez (se comprueba antes de cada envio).
MAX_OPEN_LIVE_TRADES=5

# Antiguedad maxima (segundos) de una orden real resting antes de cancelarla en la
# reconciliacion: `good_till_canceled` no caduca sola.
LIVE_ORDER_MAX_AGE_SEC=900

# Puerta de promocion: si esta activa, una estrategia solo puede enviar ordenes
# reales cuando el tablero de promocion la marca LIVE_PEQUENO o LIVE (significancia
# con Bonferroni + holdout). Dejalo en true salvo para pruebas explicitas.
LIVE_REQUIRE_PROMOTION=true

# ===== Deteccion de entorno =====
# Se usa /portfolio/positions y no /portfolio/balance: en demo el endpoint de
# balance devuelve HTTP 500 intermitentemente (~30% de los intentos medidos) y eso
# hacia que la deteccion descartara demo y aterrizara en produccion.
KALSHI_ENV_PROBE_PATH=/portfolio/positions
KALSHI_ENV_PROBE_ATTEMPTS=3

KALSHI_WEBSOCKET_ENABLED=true
MIN_LIQUIDITY=0
MIN_VOLUME_24H=0
MAX_MARKETS_TRACKED=500
MAX_ORDERBOOK_POLLS_PER_CYCLE=50

# ===== Universo de mercados =====
# Kalshi crea miles de mercados y solo ~14% registran volumen. El bot escanea
# MAX_MARKETS_SCANNED por ciclo y se queda con los mas operables.
MAX_MARKETS_SCANNED=1600
MAX_MARKETS_WITH_EVENT_CONTEXT=900
MARKET_MIN_VOLUME_24H=1
MARKET_MIN_OPEN_INTEREST=1
MAX_EVENTS_TRACKED=4000
EVENT_POLL_INTERVAL=300
PRUNE_STALE_AFTER_SECONDS=1800

# ===== Admision de operaciones en Paper Trading =====
# Kalshi envia liquidity_dollars en 0.00, asi que la liquidez se evalua con el
# mejor indicador disponible (liquidez, volumen 24h, open interest, profundidad).
PAPER_MIN_LIQUIDITY_USD=500
PAPER_MIN_VOLUME_24H_USD=250
PAPER_MIN_OPEN_INTEREST=100
PAPER_MIN_CONFIDENCE=75
PAPER_ALLOW_NON_FLASH=1

# ===== Bankroll: debe coincidir con el capital real a fondear =====
# Si no coinciden, cada decision de sizing/Kelly cambia al pasar a live.
PAPER_INITIAL_BALANCE=1000
PAPER_MAX_EXPOSURE_USD=1000
PAPER_MAX_OPEN_POSITIONS=12

# ===== Realismo de ejecucion =====
# tick   -> fill realista (tick legal, profundidad, cola maker, comision, latencia)
# legacy -> comportamiento anterior (slippage en bps, comision plana); solo comparar
PAPER_FILL_MODEL=tick
# Kalshi cobra al taker ceil_a_centavo(0.07 * contratos * P * (1-P)); maker 0.
# El redondeo a centavo pesa muchisimo en contratos baratos: a 0.03 la comision es
# el 33% de la apuesta y sube el breakeven de 3.0% a 4.0%.
PAPER_FEE_TAKER_RATE=0.07
PAPER_FEE_MAKER_RATE=0.0
# Latencia entre el snapshot de la senal y la orden en el libro (572 ms medidos).
PAPER_LATENCY_MS=900
# Probabilidad de fill pasivo por ciclo: un maker esta al final de la cola.
PAPER_MAKER_FILL_PROBABILITY=0.35
PAPER_MAKER_MAX_PENDING_CYCLES=6
PAPER_DEPTH_SAFETY=0.5

# ===== Rate limits (Kalshi factura tokens; tier basic = 200 tokens/s) =====
KALSHI_READ_TOKENS_PER_SECOND=200
KALSHI_REQUEST_TOKEN_COST=10
KALSHI_RATE_HEADROOM=0.35

# ===== Mantenimiento programado (Kalshi pausa jueves 03:00-05:00 ET) =====
MAINTENANCE_DOW=3
MAINTENANCE_START_HOUR_ET=3
MAINTENANCE_END_HOUR_ET=5

